{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "entrantes",
        "principales",
        "postres",
        "bebidas"
      ]
    },
    "price": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ]
}